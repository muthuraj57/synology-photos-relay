# Upload relay configuration (KEY=value, same format as the sibling services)
PORT=5863
DSM_URL=https://127.0.0.1:5001
STAGING_DIR=./staging
CHUNK_MAX_MB=50
USER_QUOTA_GB=20
GLOBAL_QUOTA_GB=100
MAX_FILE_GB=30
# 10 days: a trip upload that stalls keeps its chunks (the timer resets on
# every received chunk); orphans from files later uploaded via LAN die here
STALE_HOURS=240
VERIFY_TLS=false

# -- SideStore/AltStore source (optional) ------------------------------------
# Disabled until SOURCE_PUBLIC_URL and APP_BUNDLE_ID are set. Drop
# <APP_NAME>-<version>.ipa files (and an optional icon.png) into IPA_DIR;
# /sidestore/source.json lists them newest-first for SideStore.
#IPA_DIR=./ipa
#SOURCE_PUBLIC_URL=https://upload.example.com
#SOURCE_NAME=Family Apps
#SOURCE_IDENTIFIER=com.example.family-source
#APP_NAME=PhotoRelay
#APP_BUNDLE_ID=com.example.photorelay
#APP_DEVELOPER=Self-hosted
#APP_DESCRIPTION=Photo and video backup to the family NAS.
#APP_MIN_OS=16.0
#APP_TINT=0C1346
